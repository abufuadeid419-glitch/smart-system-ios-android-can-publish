  "typography": {
    "displayFontFamily": "Cairo",
    "textFontFamily": "Cairo",
    "scale": {
      "sm": 12,
      "base": 14,
      "lg": 16,
      "xl": 20,
      "2xl": 24
    }
  },
  "spacing": {
    "rule": "Generous spacing for tap targets (≥ 44pt); padding around related groups for quick visual scanning.",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48
  },
  "radius_tokens": {
    "sm": 6,
    "md": 12,
    "lg": 20,
    "pill": 999
  },
  "shadow_tier": 1,
  "navigation": "bottom_tabs",
  "icon_set": "Feather",
  "glassmorphism": {
    "enabled": true,
    "do's": [
      "Use blur on bottom tab bar over scrolling content",
      "Use blur on floating action buttons (FABs)"
    ],
    "dont's": [
      "Never blur forms, lists or data-heavy dashboard cards"
    ]
  },
  "platform_libraries": {
    "glass": {
      "ios": "expo-glass-effect",
      "android": "expo-blur",
      "low_end_android_fallback": "solid surfaceSecondary"
    },
    "image": "expo-image",
    "blur": "expo-blur",
    "bottom_sheet": "@gorhom/bottom-sheet",
    "animation": "react-native-reanimated",
    "gesture": "react-native-gesture-handler"
  },
  "screens": [
    {
      "name": "Login",
      "purpose": "Secure entry via phone + password with first-time SMS verification.",
      "states": {
        "loading": "Spinner over brand-tinted gradient background",
        "empty": "N/A",
        "error": "Bottom sheet or snackbar explaining authentication failure"
      },
      "layout": "Bottom-heavy card over abstract architectural background. Large touch inputs and sticky continue CTA above keyboard."
    },
    {
      "name": "Owner Dashboard",
      "purpose": "High-level analytics hub showing KPI cards (sales, collections) and recent activity.",
      "states": {
        "loading": "Skeleton grids for KPI cards",
        "empty": "Illustration of empty desk, prompting to start operations",
        "error": "Central alert to retry fetching analytics"
      },
      "layout": "Top sticky segmented controls for date filters. 2-column KPI grid, followed by vertical list of recent invoices."
    },
    {
      "name": "Inventory List",
      "purpose": "Searchable list of products with current stock levels.",
      "states": {
        "loading": "List skeletons",
        "empty": "Warehouse boxes illustration with 'No products found' message",
        "error": "Retry connection card"
      },
      "layout": "Sticky search header. Single-column list items with thumbnail, product name, and stock status pill. FAB for adding stock."
    }
  ],
