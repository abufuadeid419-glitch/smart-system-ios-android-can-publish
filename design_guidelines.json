  "instructions_to_main_agent": [
    "Strictly preserve the 'Cairo' font and ensure all text aligns RTL as this is an Arabic app.",
    "Replace the existing navy/coral theme tokens with the provided Forest Green / Slate palette to modernize and improve perceived trust and operational clarity.",
    "Do NOT use indigo, violet, navy, or orange anywhere in the app per the design rules.",
    "Keep weights at 400/500 max. Do NOT use bold or black font weights, rely on size scale instead.",
    "Apply subtle glassmorphism (expo-blur) for sticky headers and bottom tab bars over scrolling data.",
    "Implement loading skeletons instead of blank spinners on the dashboard and lists.",
    "Ensure touch targets remain strictly >= 44x44pt.",
    "Support dark mode rigorously—many operational users may check data in low light."
  ],
  "events": {
    "onPressPrimaryAction": "impactMedium",
    "onTabSelect": "selection",
    "onToggleSwitch": "impactLight",
    "onErrorState": "notificationError",
    "onSuccessState": "notificationSuccess"
  }
}